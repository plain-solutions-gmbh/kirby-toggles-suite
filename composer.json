{
  "name": "plain/kirby-toggles-suite",
  "description": "Colorize your Kirby toggler field",
  "homepage": "https://github.com/plain-solutions-gmbh/",
  "license": "MIT",
  "type": "kirby-plugin",
  "version": "2.0.0-beta.1",
  "authors": [
    {
      "name": "Roman Gsponer",
      "email": "kirby@plain-solutions.net"
    }
  ],
  "require": {
    "getkirby/composer-installer": "^1.1"
  },
  "extra": {
    "kirby": {
      "compatible": "^6.0"
    }
  },
  "autoload": {
    "psr-4": {
      "Plain\\Toggles\\": "classes/"
    }
  },
  "config": {
    "optimize-autoloader": true
  }
}